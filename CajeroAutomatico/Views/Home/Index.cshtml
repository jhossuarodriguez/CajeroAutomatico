@{
    ViewData["Title"] = "Cajero Automatico";
}

<section class="container-hero rounded-1 bg-transparent fw-bold">
    <div class="text text-center text-uppercase">
        <h1>Cajero Automatico</h1>
        <h2>Completar los campos requeridos*</h2>
    </div>

    <form class="form"  method="post" action="#">
        <div class="form-group">
            <div>
                <label for="monto">Monto que desea retirar</label>
                <input 
                    type="number"
                    class="form-control"
                    id="monto" 
                    ame="monto" 
                    placeholder="Introduzca un numero entero"
                    min="100" 
                    step="100" 
                    required>
            </div>
            <div class="mt-3 gap-3 boton btn-btn rounded-3 mb-4  ">
                <a href="@Url.Action("Configuration")" class="btn btn-primary" >
                    Seleccionar Modo
                </a>
                <button type="button" class="btn btn-primary" href="">Retirar</button>
            </div>

        </div>
    </form>
</section>
@if (ViewBag.Resultado != null)
{
   <h3 class="text-center text-primary">Billetes Retirados</h3>
    <ul>
        @foreach (var item in ViewBag.Resultado)
        {
            <li>@item.Value billete(s) @item.Key</li>
        }
    </ul>
}

@if (ViewBag.Mensaje != null){
    <h3 class="text-danger">@ViewBag.Mensaje</h3>
}