@{
    ViewData["Title"] = "Cajero Automatico";
}

<section class="container-hero rounded-1 bg-transparent fw-bold">
    <div class="text text-center text-uppercase">
        <h1>Cajero Automatico</h1>
        <h2>Completar los campos requeridos*</h2>
    </div>

    <form class="form d-flex flex-column justify-content-between" method="get" action="#">
        <div class="form-group">
            <img class="logo" src="~/images/logo.webp" alt="Imagen Banco" />
            <div>
                <label for="monto">Monto que desea retirar</label>
                <input type="number" class="form-control" id="monto" name="monto" placeholder="Introduzca un numero entero">
            </div>
            
            <div class="boton m-2  btn-btn">
                <button class="rounded-3 btn btn-primary">Retirar</button>
            </div>

        </div>
    </form>
</section>