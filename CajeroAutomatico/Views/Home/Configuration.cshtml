@model CajeroAutomatico.Models.Configuration

﻿@{
    ViewData["Title"] = "Configuracion del Modo Dispensacion";
}

<div class="d-flex flex-column justify-content-center align-items-center">
    <h1 class="m-5">Configuracion del Modo Dispensacion</h1>

    <form asp-action="Configuration" method="post" class="form">
        <div class="form-group">
            <select asp-for="ModoSeleccionado" class="form-control" asp-items="Html.GetEnumSelectList<CajeroAutomatico.Models.CajeroModel.ModoDispensacion>()" class="form-select">
                <option value="">Seleccione un modo de dispensacion</option>
            </select>
        </div>

        <div class="justify-content-center mt-5 gap-5">
            <a class="btn btn-primary" href="@Url.Action("Index", "Home")">Volver</a>
            <button class="btn btn-primary" type="submit">Guardar</button>
        </div>
    </form>
</div>

